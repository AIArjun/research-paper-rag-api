# Research Observatory (frontend/) — server-only environment. Never commit real values.
# Every variable is read only inside Next.js route handlers / server components.
# Nothing here is exposed to the browser bundle (no NEXT_PUBLIC_ prefix on purpose).

# Base URL of the protected Research Paper RAG API (no trailing slash).
RAG_API_URL=https://research-paper-rag-api.onrender.com

# The API's shared bearer token (Render DEMO_ACCESS_TOKEN). Held server-side only.
RAG_API_TOKEN=

# Passcode demo visitors type on the entry screen. 24+ random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DEMO_PASSCODE=

# Secret used to sign the HttpOnly session cookie. 32+ random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Optional. Comma-separated list of exact browser origins allowed to make
# state-changing requests (login, upload, query). On Vercel the deployment's own
# system URLs are trusted automatically; set this for a custom domain, e.g.
# APP_ORIGIN=https://observatory.example.com
APP_ORIGIN=
