# Research Paper RAG API — Environment Variables
# Example values only. Never commit a real token or provider key.

# LLM Provider: "openai", "ollama", or "demo"
LLM_PROVIDER=demo

# OpenAI Configuration (if LLM_PROVIDER=openai)
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-your-key-here

# Ollama Configuration (if LLM_PROVIDER=ollama)
# LLM_MODEL=llama3
# OLLAMA_URL=http://localhost:11434

# ─── Protected shared demo (Stage 2c) ───
# Required for every route except /, /docs, /redoc, /openapi.json, /health and /ready.
# At least 32 printable ASCII characters, no whitespace. Left empty on purpose so a
# copied example fails closed (503 access_not_configured). Generate a value with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DEMO_ACCESS_TOKEN=

# Explicit browser origins allowed by CORS (comma-separated). Empty = none. No wildcards.
ALLOWED_ORIGINS=

# Bounded provider use (real providers only). Retries are always zero.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=400

# Model-call accounting. Real generation stays disabled until ALL five are set.
# JSON request bodies are capped at 32 KiB (a 2000-character question in any encoding fits).
# The ledger is a SQLite file; it must live on durable storage to survive restarts.
MODEL_CALL_LEDGER_PATH=
MAX_MODEL_CALLS_PER_DAY=0
MAX_MODEL_CALLS_TOTAL=0
MAX_MODEL_TOKENS_PER_DAY=0
MAX_MODEL_TOKENS_TOTAL=0

# Resource bounds (initial demo ceilings, not proven production capacities)
MAX_FILE_SIZE_MB=10
MAX_PDF_PAGES=60
MAX_CHUNKS_PER_PAPER=600
MAX_PAPERS=20
MAX_TOTAL_CHUNKS=3000
MAX_CONTEXT_CHARS=6000
MAX_CONCURRENT_QUERIES=2

# Embedding Model (HuggingFace sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector Store
VECTORSTORE_PATH=./vectorstore

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Server
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO
